{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "tailwind.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    ".next-fix53proof/types/**/*.ts",
    ".next-interview-lock/types/**/*.ts",
    ".next-duck-e2e/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-interview-lock/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
